# BidOS configuration. Copy to .env; environment variables override this file.
# Everything works with no keys at all (demo mode, deterministic AI floor).

# --- server ---------------------------------------------------------------------------
BIDOS_ADDR=:8080
BASE_URL=http://localhost:8080
DEMO_MODE=true                 # seeds the synthetic workspace on start; demo login picker
VERTICAL_PACK=saas-it          # saas-it | legal-services
DATABASE_URL=storage/bidos.db  # SQLite file (pure Go driver)
STORAGE_DIR=storage            # uploaded files, exports
SESSION_SECRET=                # set in production; CSRF tokens derive from it
MAX_UPLOAD_BYTES=26214400
WORKERS=4                      # in-process job workers for `bidos serve` (0 = external worker)
CRON_SECRET=                   # enables POST /api/cron/tick for host cron (X-Cron-Secret header)
LOG_JSON=false
DEBUG_PROMPTS=false

# --- AI providers (optional; demo floor is always the last provider) ------------------
# Local model through an OpenAI-compatible endpoint (Ollama, LM Studio, vLLM):
#LOCAL_MODEL=llama3.1
#LOCAL_BASE_URL=http://localhost:11434/v1
# Hosted OpenAI-compatible provider (free tier or paid):
#AI_BASE_URL=https://api.example.com/v1
#AI_MODEL=model-name
#AI_API_KEY=
#AI_MODE=free_tier             # local | free_tier | paid
#AI_RPM=20
#AI_TOKENS_PER_DAY=200000
#AI_ALLOW_INTERNAL=false       # may internal (non-synthetic) data be sent to this provider?
#AI_ALLOW_CONFIDENTIAL=false
# Or describe several providers in ai.providers.json (see ai.providers.example.json):
AI_ROUTER_CONFIG=ai.providers.json

# --- embeddings (optional; hashed n-gram embeddings are the offline floor) -------------
ENABLE_EMBEDDINGS=true
#EMBEDDINGS_BASE_URL=https://api.example.com/v1
#EMBEDDINGS_MODEL=text-embedding-3-small
#EMBEDDINGS_API_KEY=

# --- integrations (all optional, each has a local fallback) ---------------------------
#SLACK_WEBHOOK_URL=
#CLICKUP_TOKEN=
#CLICKUP_LIST_ID=
#ERROR_WEBHOOK_URL=
ENABLE_EMAIL_INTAKE=false
INBOX_DIR=storage/inbox

# --- public sandbox (each demo launch gets its own expiring organization) --------------
ENABLE_PUBLIC_SANDBOX=false
SANDBOX_TTL_HOURS=24
